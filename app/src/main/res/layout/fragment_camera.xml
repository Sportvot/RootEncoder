<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_example_rtmp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appColor">

  <SurfaceView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:id="@+id/surfaceView"
      />

  <WebView
      android:id="@+id/overlayWebView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="visible"
      android:background="@android:color/transparent" />

  <WebView
      android:id="@+id/scoringWebView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="visible"
      android:background="@android:color/transparent" />

  <!-- Gradient overlay for better text visibility -->
  <View
      android:id="@+id/gradientOverlay"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:background="@drawable/gradient_overlay"
      app:layout_constraintTop_toTopOf="parent" />

  <EditText
      android:hint="@string/hint_protocol"
      android:textColor="@android:color/white"
      android:textColorHint="@android:color/white"
      android:inputType="textUri"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:layout_margin="40dp"
      android:background="@android:color/transparent"
      android:id="@+id/et_rtp_url"
      app:layout_constraintTop_toTopOf="parent"
      />

  <TextView
      android:id="@+id/txt_bitrate"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@android:color/white"
      android:textSize="12sp"
      android:layout_marginStart="16dp"
      android:layout_marginTop="10dp"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <TextView
      android:id="@+id/txt_resolution"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@android:color/white"
      android:textSize="12sp"
      android:layout_marginStart="16dp"
      app:layout_constraintStart_toEndOf="@id/txt_bitrate"
      app:layout_constraintTop_toTopOf="@id/txt_bitrate"
      app:layout_constraintBottom_toBottomOf="@id/txt_bitrate" />

  <TextView
      android:id="@+id/txt_min_bitrate"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@android:color/white"
      android:textSize="12sp"
      android:layout_marginStart="16dp"
      app:layout_constraintStart_toEndOf="@id/txt_resolution"
      app:layout_constraintTop_toTopOf="@id/txt_bitrate"
      app:layout_constraintBottom_toBottomOf="@id/txt_bitrate" />

  <TextView
      android:id="@+id/txt_max_bitrate"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@android:color/white"
      android:textSize="12sp"
      android:layout_marginStart="16dp"
      android:visibility="gone"
      app:layout_constraintStart_toEndOf="@id/txt_min_bitrate"
      app:layout_constraintTop_toTopOf="@id/txt_bitrate"
      app:layout_constraintBottom_toBottomOf="@id/txt_bitrate" />

  <TextView
      android:id="@+id/txt_codec"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@android:color/white"
      android:textSize="12sp"
      android:layout_marginStart="16dp"
      app:layout_constraintStart_toEndOf="@id/txt_max_bitrate"
      app:layout_constraintTop_toTopOf="@id/txt_bitrate"
      app:layout_constraintBottom_toBottomOf="@id/txt_bitrate" />

  <TextView
      android:id="@+id/txt_bitrate_mode"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@android:color/white"
      android:textSize="12sp"
      android:layout_marginStart="16dp"
      app:layout_constraintStart_toEndOf="@id/txt_codec"
      app:layout_constraintTop_toTopOf="@id/txt_bitrate"
      app:layout_constraintBottom_toBottomOf="@id/txt_bitrate" />

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="16dp"
      app:layout_constraintBottom_toBottomOf="parent">

    <!-- 1️⃣ Record -->
    <ImageView
        android:id="@+id/b_record"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/record_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/switch_camera" />

    <!-- 2️⃣ Switch Camera -->
    <ImageView
        android:id="@+id/switch_camera"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/switch_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/b_record"
        app:layout_constraintEnd_toStartOf="@id/b_start_stop" />

    <!-- 3️⃣ Stream (center) -->
    <ImageView
        android:id="@+id/b_start_stop"
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:src="@drawable/stream_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/switch_camera"
        app:layout_constraintEnd_toStartOf="@id/toggleOverlayButton" />

    <!-- 4️⃣ GFX -->
    <Button
        android:id="@+id/toggleOverlayButton"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:text="GFX"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        android:contentDescription="@string/toggle_overlay"
        android:gravity="center"
        android:alpha="0.75"
        android:background="@drawable/white_rounded_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/b_start_stop"
        app:layout_constraintEnd_toStartOf="@id/toggleScoringButton" />

    <!-- 5️⃣ Score -->
    <Button
        android:id="@+id/toggleScoringButton"
        android:layout_width="100dp"
        android:layout_height="56dp"
        android:text="SCORE"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        android:contentDescription="@string/toggle_overlay"
        android:gravity="center"
        android:alpha="0.75"
        android:background="@drawable/white_rounded_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/toggleOverlayButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread" />

  </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
